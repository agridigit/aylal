[
  {
    "name": "valid minimal",
    "rule": "trial_record.create",
    "input": {
      "title": "a"
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "valid trimmed title",
    "rule": "trial_record.create",
    "input": {
      "title": "  a  ",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "valid title 120 chars",
    "rule": "trial_record.create",
    "input": {
      "title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "valid quantity zero",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": null,
      "quantity": 0
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "valid quantity max",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": null,
      "quantity": 1000000
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "valid note 2000 chars",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": "",
      "quantity": 1
    },
    "expect": {
      "valid": true,
      "errors": []
    }
  },
  {
    "name": "missing title",
    "rule": "trial_record.create",
    "input": {
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "required"
        }
      ]
    }
  },
  {
    "name": "empty title",
    "rule": "trial_record.create",
    "input": {
      "title": "",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "too_short"
        }
      ]
    }
  },
  {
    "name": "blank title after trim",
    "rule": "trial_record.create",
    "input": {
      "title": "   ",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "too_short"
        }
      ]
    }
  },
  {
    "name": "title 121 chars",
    "rule": "trial_record.create",
    "input": {
      "title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "too_long"
        }
      ]
    }
  },
  {
    "name": "title 121 chars after trim still too long",
    "rule": "trial_record.create",
    "input": {
      "title": " xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "note": null,
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "too_long"
        }
      ]
    }
  },
  {
    "name": "negative quantity",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": null,
      "quantity": -0.01
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "quantity",
          "code": "out_of_range"
        }
      ]
    }
  },
  {
    "name": "quantity above max",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": null,
      "quantity": 1000000.01
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "quantity",
          "code": "out_of_range"
        }
      ]
    }
  },
  {
    "name": "note 2001 chars",
    "rule": "trial_record.create",
    "input": {
      "title": "Taille",
      "note": "",
      "quantity": 1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "note",
          "code": "too_long"
        }
      ]
    }
  },
  {
    "name": "two errors reported",
    "rule": "trial_record.create",
    "input": {
      "title": "",
      "note": null,
      "quantity": -1
    },
    "expect": {
      "valid": false,
      "errors": [
        {
          "field": "title",
          "code": "too_short"
        },
        {
          "field": "quantity",
          "code": "out_of_range"
        }
      ]
    }
  }
]