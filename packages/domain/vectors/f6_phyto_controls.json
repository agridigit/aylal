{
 "cases": [
  {"name": "compliant treatment has no warning",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 1.5, "dose_unit": "L/ha", "applications_so_far": 1},
   "expected": []},
  {"name": "dose above the registered maximum",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 2.5, "dose_unit": "L/ha", "applications_so_far": 0},
   "expected": ["dose_above_max"]},
  {"name": "dose in a convertible unit above the maximum",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 1, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 1500, "dose_unit": "mL/ha", "applications_so_far": 0},
   "expected": ["dose_above_max"]},
  {"name": "dose in a convertible unit below the maximum",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 1, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 800, "dose_unit": "mL/ha", "applications_so_far": 0},
   "expected": []},
  {"name": "dose in a non convertible unit is not compared",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 1, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 5, "dose_unit": "kg/ha", "applications_so_far": 0},
   "expected": []},
  {"name": "crop not authorised for the product",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "olive", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 9, "dose_unit": "L/ha", "applications_so_far": 9},
   "expected": ["not_authorized_for_crop"]},
  {"name": "parcel without a crop is not authorised",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "olive", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": null, "dose": 1, "dose_unit": "L/ha", "applications_so_far": 0},
   "expected": ["not_authorized_for_crop"]},
  {"name": "maximum number of applications reached",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 1, "dose_unit": "L/ha", "applications_so_far": 3},
   "expected": ["max_applications_reached"]},
  {"name": "one application left is still fine",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "crop_slug": "tomato", "dose": 1, "dose_unit": "L/ha", "applications_so_far": 2},
   "expected": []},
  {"name": "unknown pre-harvest interval",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": null, "max_applications": null}], "crop_slug": "tomato", "dose": 1, "dose_unit": "L/ha", "applications_so_far": 0},
   "expected": ["dar_unknown"]},
  {"name": "several warnings come in a stable order",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 1, "dose_unit": "L/ha", "dar_days": null, "max_applications": 2}], "crop_slug": "tomato", "dose": 3, "dose_unit": "L/ha", "applications_so_far": 2},
   "expected": ["dose_above_max", "max_applications_reached", "dar_unknown"]},
  {"name": "free product is flagged as unchecked and nothing else",
   "input": {"free_product_name": "Maison", "uses": [], "crop_slug": "tomato", "dose": 99, "dose_unit": "L/ha", "applications_so_far": 50},
   "expected": ["free_product_unchecked"]},
  {"name": "product and dose are never required",
   "input": {"uses": [], "crop_slug": "tomato", "dose": null, "dose_unit": null, "applications_so_far": 0},
   "expected": []},
  {"name": "catalogue product without a dose still gets the other controls",
   "input": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 1}], "crop_slug": "tomato", "dose": null, "dose_unit": null, "applications_so_far": 1},
   "expected": ["max_applications_reached"]}
 ],
 "by_parcel": [
  {"name": "controls apply parcel by parcel on different crops",
   "base": {"product_id": "p1", "uses": [{"crop_slug": "tomato", "max_dose": 2, "dose_unit": "L/ha", "dar_days": 7, "max_applications": 3}], "dose": 1, "dose_unit": "L/ha"},
   "parcels": [{"id": "a", "crop_slug": "tomato", "applications_so_far": 0}, {"id": "b", "crop_slug": "olive", "applications_so_far": 0}, {"id": "c", "crop_slug": "tomato", "applications_so_far": 3}],
   "expected": {"a": [], "b": ["not_authorized_for_crop"], "c": ["max_applications_reached"]}}
 ]
}
