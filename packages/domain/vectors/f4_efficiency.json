  },
  "expected": {
   "efficiency": 0.8,
   "is_default": false
  }
 },
 {
  "name": "override of 1 is the upper bound",
  "fn": "resolve_efficiency",
  "input": {
   "kind": "gravity",
   "efficiency": 1
  },
  "expected": {
   "efficiency": 1,
   "is_default": false
  }
