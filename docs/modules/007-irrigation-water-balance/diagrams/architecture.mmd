    SYNC[sync/irrigation.py]
    WV[worker_view.py]
  end
  subgraph Workers["services/workers (Arq)"]
    CP[compute_irrigation_plans]
    REM[send_irrigation_reminders]
    IMP[import_irrigation_params]
