      "minLength": 1,
      "maxLength": 120
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "anyOf": [
        {
