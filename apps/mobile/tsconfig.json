{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@aylal/domain/*": [
        "../../packages/domain/src/*"
      ],
      "@aylal/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@aylal/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@aylal/ui/motion": [
        "../../packages/ui/src/motion.ts"
      ]
    },
    "customConditions": [
      "react-native"
    ]
  },
  "include": [
    "src",
    "app"
  ]
}
