{
	local_certs
}

localhost, proxy {
	tls internal
	reverse_proxy /sync/* powersync:8080
	reverse_proxy api-edge:8000 {   # via the dedicated edge network: the API sees Caddy at its static address
		# the client cannot forge its IP: overwrite the forwarded headers with the real peer
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}
